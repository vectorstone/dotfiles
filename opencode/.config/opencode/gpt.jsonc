{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "model_fallback": true,
  "runtime_fallback": {
    "enabled": true,
    "max_fallback_attempts": 2,
    "notify_on_fallback": true
  },
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "fallback_models": [
        "openai/gpt-5.4",
        "openai/gpt-5.4-mini"
      ],
      "reasoningEffort": "medium",
      "textVerbosity": "medium"
    },
    "hephaestus": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "fallback_models": [
        "openai/gpt-5.4",
        "openai/gpt-5.4-mini"
      ],
      "reasoningEffort": "medium",
      "textVerbosity": "medium"
    },
    "prometheus": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "openai/gpt-5.4"
      ],
      "prompt_append": "Always produce decision-complete plans. Separate facts, assumptions, risks, and validation steps.",
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "oracle": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "openai/gpt-5.4"
      ],
      "prompt_append": "Prefer root-cause analysis over local symptom patching.",
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "librarian": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": [
        "openai/gpt-5.4"
      ],
      "variant": "low",
      "reasoningEffort": "low",
      "textVerbosity": "low"
    },
    "explore": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": [
        "openai/gpt-5.4"
      ],
      "variant": "low",
      "reasoningEffort": "low",
      "textVerbosity": "low"
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "fallback_models": [
        "openai/gpt-5.4"
      ],
      "reasoningEffort": "medium",
      "textVerbosity": "medium"
    },
    "metis": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "openai/gpt-5.4"
      ],
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "momus": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": [
        "openai/gpt-5.4"
      ],
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "atlas": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "fallback_models": [
        "openai/gpt-5.4-mini"
      ],
      "reasoningEffort": "medium",
      "textVerbosity": "low"
    },
    "sisyphus-junior": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "fallback_models": [
        "openai/gpt-5.4-mini"
      ],
      "reasoningEffort": "medium",
      "textVerbosity": "low"
    }
  },
  "categories": {
    "quick": {
      "model": "openai/gpt-5.4-mini",
      "variant": "low",
      "reasoningEffort": "low",
      "textVerbosity": "low"
    },
    "unspecified-low": {
      "model": "openai/gpt-5.4-mini",
      "variant": "low",
      "reasoningEffort": "low",
      "textVerbosity": "low"
    },
    "unspecified-high": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "reasoningEffort": "medium",
      "textVerbosity": "medium"
    },
    "deep": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "reasoningEffort": "medium",
      "textVerbosity": "medium"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "reasoningEffort": "xhigh",
      "textVerbosity": "medium"
    },
    "writing": {
      "model": "openai/gpt-5.4",
      "variant": "medium",
      "reasoningEffort": "medium",
      "textVerbosity": "medium"
    },
    "visual-engineering": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "reasoningEffort": "medium",
      "textVerbosity": "medium"
    },
    "artistry": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    }
  }
}
