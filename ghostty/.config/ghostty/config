# ===========================
# Ghostty 共享配置（macOS / Linux）
# ===========================

# --- 外观 ---
theme = light:Catppuccin Mocha,dark:Catppuccin Mocha

# 让带显式背景色的应用（如 nvim/tmux）也应用透明度，跨平台观感更一致
background-opacity-cells = true

# 非活跃分屏的透明度
unfocused-split-opacity = 0.9

# --- 字体 ---
font-family = "Maple Mono NF CN"
font-size = 11

# 连字支持
font-feature = calt
font-feature = liga

# --- 窗口行为 ---
window-save-state = always
window-inherit-working-directory = true
window-inherit-font-size = true
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true

# --- Quick Terminal（下拉终端） ---
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-screen = main
quick-terminal-position = left
quick-terminal-size = 50%
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

# --- Shell 集成 ---
shell-integration-features = cursor,sudo,title,ssh-terminfo,ssh-env

# --- 滚动 ---
scrollback-limit = 50000000

# --- 光标 ---
cursor-style = block
cursor-style-blink = false

# 鼠标隐藏（打字时自动隐藏鼠标）
mouse-hide-while-typing = true

# --- 剪贴板 ---
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
